# ----------------------------------------------------------------------------
#  نمونه‌ی متغیرهای محیطی همدل — فقط جای‌نگهدار است؛ مقادیر واقعی را اینجا نگذارید.
#  در Vercel از بخش Environment Variables مقداردهی کنید (نوع: Encrypted).
# ----------------------------------------------------------------------------

# رشته‌ی اتصال PostgreSQL (Supabase → Connect → Session pooler، پورت 5432)
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Storage (برای ذخیره‌ی تصاویر)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=hamdel-media

# اختیاری: اگر کدهای ثبت‌نام کادر، ورود مدیر ارشد یا پاک‌سازی تغییر کرده باشند،
# هش SHA-256 مقدار جدید را اینجا بگذارید. در غیر این صورت هش‌های پیش‌فرض برنامه استفاده می‌شوند.
# HAMDEL_STAFF_KEY_HASH=
# HAMDEL_DEV_LOGIN_HASH=
# HAMDEL_WIPE_HASH=

# اختیاری: تعداد اتصال‌های هر نمونه‌ی سرور (پیش‌فرض ۳ روی Vercel)
# PG_POOL_MAX=3
