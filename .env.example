# ---------------------------------------------------------------------------
# هَمدِل — نمونه‌ی متغیرهای محیطی (بدون هیچ رمز یا کلید واقعی)
# برای اجرای محلی: این فایل را به .env.local کپی کنید و مقادیر را پر کنید.
# در Vercel همین متغیرها را در Project Settings → Environment Variables تعریف کنید.
# ---------------------------------------------------------------------------

# ---- پایگاه‌داده (Supabase / PostgreSQL) -----------------------------------
# روش ۱ (پیشنهادی): رشته‌ی اتصال کامل به Supavisor (Session pooler, پورت 5432)
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres

# روش ۲: برنامه خودش میزبان Pooler را از روی مشخصات پروژه می‌سازد و در صورت خطا میزبان دیگر را امتحان می‌کند
# SUPABASE_PROJECT_REF=<PROJECT_REF>
# SUPABASE_DB_PASSWORD=<DB_PASSWORD>
# SUPABASE_REGION=eu-central-1

# (اختیاری) تنظیمات اتصال
# PG_SSL=true
# PG_POOL_MAX=3

# ---- Supabase Storage (تصاویر، آواتار و فایل‌های پیام) ----------------------
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
# کلید service_role فقط در سرور استفاده می‌شود و هرگز نباید در مخزن Git یا کد سمت کلاینت قرار گیرد.
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>
# نام سطل ذخیره‌سازی (پیش‌فرض: hamdel-media)
SUPABASE_STORAGE_BUCKET=hamdel-media

# ---- حساب پیش‌فرض مدیر و رمز حذف (فقط برای راه‌اندازی اولیه) ----------------
# اگر تنظیم نشوند، مقدار پیش‌فرض استفاده می‌شود. پس از اولین ورود، رمزها را در پنل مدیر تغییر دهید.
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=
# DEFAULT_DELETE_PASSWORD=

# ---- محلی (بدون Supabase) -------------------------------------------------
# اگر DATABASE_URL و تنظیمات Supabase موجود نباشد، برنامه از PGlite روی دیسک استفاده می‌کند.
# PGLITE_DATA_DIR=./.data/pglite
